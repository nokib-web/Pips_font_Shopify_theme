{% doc %}
  @prompt
    Create a custom theme section that adds a translucent background image to the catalog/collections page. The background image should use this URL: https://cdn.shopify.com/s/files/1/1078/6524/3987/files/ChatGPT_Image_Jun_11_2026_06_00_56_PM.png?v=1781197366. The section should cover the full width of the page behind the product grid, with a customisable opacity setting (defaulting to around 20-30% opacity so it's subtle and translucent). The image should be fixed or cover the full page background, and the section should have an image picker setting so the merchant can change the image, and an opacity/transparency range slider setting.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-bg-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    display: block;
  }

  .ai-collection-bg-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: {{ block.settings.image_opacity | divided_by: 100.0 }};
  }

  .ai-collection-bg-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    opacity: {{ block.settings.image_opacity | divided_by: 100.0 }};
  }

  .ai-collection-bg-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 800px;
    max-height: 800px;
  }

  .ai-collection-bg-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    padding: 16px 24px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 8px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }
{% endstyle %}

<collection-background-{{ ai_gen_id }}
  class="ai-collection-bg-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.background_image %}
    <img
      src="{{ block.settings.background_image | image_url: width: 2000 }}"
      alt="{{ block.settings.background_image.alt | escape }}"
      loading="lazy"
      width="{{ block.settings.background_image.width }}"
      height="{{ block.settings.background_image.height }}"
      class="ai-collection-bg-image-{{ ai_gen_id }}"
    >
  {% else %}
    <div class="ai-collection-bg-placeholder-{{ ai_gen_id }}">
      {{ 'collection-apparel-1' | placeholder_svg_tag }}
      <div class="ai-collection-bg-empty-state-{{ ai_gen_id }}">
        Add a background image to get started
      </div>
    </div>
  {% endif %}
</collection-background-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Collection background",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Image",
      "info": "Recommended: 2000px wide or larger for best quality"
    },
    {
      "type": "range",
      "id": "image_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Opacity",
      "default": 25
    }
  ],
  "presets": [
    {
      "name": "Collection background"
    }
  ]
}
{% endschema %}
